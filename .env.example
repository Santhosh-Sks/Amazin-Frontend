# In your frontend directory, run this command to create the file:
@"
# The root URL of the deployed backend API.
VITE_API_BASE_URL=https://your-backend-url.onrender.com

# Other app configurations
VITE_APP_NAME=Amazin Mart
VITE_OTP_EXP_MINUTES=5
VITE_NODE_ENV=production
"@ | Out-File -FilePath ".env.example" -Encoding UTF8